# Brevo transactional email. The sender address must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=SmartQueue

# Existing server configuration
NODE_ENV=development
PORT=5001
JWT_SECRET=
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional: comma-separated list of allowed browser origins (overrides CLIENT_URL)
CLIENT_URLS=

# Optional SMS delivery via Twilio (server-side only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# npm run seed wipes all tables; it refuses to run in production unless this is true
ALLOW_DESTRUCTIVE_SEED=false
